# AlphaForge 全局配置（占位值，复制为 .env 后按需修改）
# 键名与 backend/app/config.py 的 Settings 字段一一对应；未识别的键会被忽略，
# 但已知键的错误值会导致启动失败（快速失败，不会带病上线）。

# ---- LLM（定性推理）----
# heuristic = 确定性规则引擎，离线可复现，默认；openai = OpenAI 兼容端点
LLM_PROVIDER=heuristic
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2

# ---- 行情数据源 ----
# akshare = 真实 A 股数据；synthetic = 内置合成行情（离线开发/测试）
DATA_PROVIDER=akshare
KLINE_LOOKBACK_DAYS=500
BENCHMARK_SYMBOL=000300
DATA_REQUEST_TIMEOUT_S=20
DATA_MAX_RETRIES=3
DATA_RETRY_BASE_WAIT_S=0.5
DATA_RETRY_MAX_WAIT_S=4
NEWS_LIMIT=10

# ---- 回测成本模型（A 股）----
COMMISSION_RATE=0.0003
COMMISSION_MIN=5
STAMP_TAX_RATE=0.001
TRANSFER_FEE_RATE=0.00002
SLIPPAGE=0.001
LOT_SIZE=100
INITIAL_CAPITAL=1000000

# ---- 分析参数 ----
DEBATE_ROUNDS=2
MAX_CONCURRENT_TASKS=4
# 调试用：图节点间人工延迟（毫秒），生产保持 0
DEBUG_STEP_DELAY_MS=0
RISK_FREE_RATE=0.02
TRADING_DAYS_PER_YEAR=252
MIN_BARS_REQUIRED=120
STALE_AFTER_DAYS=10

# ---- 持久化与缓存 ----
PERSISTENCE=mongo
MONGO_URI=mongodb://mongo:27017
MONGO_DB=alphaforge
MONGO_TIMEOUT_MS=3000
CACHE_BACKEND=redis
REDIS_URL=redis://redis:6379/0
REDIS_TTL_SECONDS=900
REDIS_CHANNEL_PREFIX=alphaforge:progress

# ---- WebSocket ----
WS_HEARTBEAT_INTERVAL_S=30
WS_SERVER_PING_INTERVAL_S=20
WS_SERVER_PING_TIMEOUT_S=20
WS_MAX_CONNECTIONS_PER_TASK=8
TASK_TTL_SECONDS=3600

# ---- 应用 ----
DEBUG=false
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]

# ---- Frontend（构建期注入；留空则走 vite 代理 /api 与 /ws）----
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
